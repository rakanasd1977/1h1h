# ===== سوق الرافدين — متغيرات بيئة الخادم (الإنتاج) =====
# انسخ هذا الملف إلى server/.env وعدّل القيم قبل التشغيل عبر npm start / PM2.
# في الإنتاج يجب تعيين JWT_SECRET وTOTP_ENC_KEY؛ غيابهما يمنع الإقلاع (فشل مغلق).

# مطلوب
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
TOTP_ENC_KEY=change-me-to-a-32-byte-hex-or-base64-encryption-key

# أساسي
NODE_ENV=production
PORT=4001
DB_PATH=./data/app.db

# CORS: نطاقات الواجهات الأربع (نفس مجالات nginx). لا تُبقِها على localhost في الإنتاج.
CORS_ORIGINS=https://rafidain.example,https://admin.rafidain.example,https://agent.rafidain.example,https://provider.rafidain.example

# العنقود: 0 = تلقائي بعدد أنوية الجهاز؛ 1 = عملية واحدة (مع PM2 instances=1)
CLUSTER_WORKERS=0

# خلف nginx/موازن تحميل حقيقي: فعّل لحساب عنوان العميل من X-Forwarded-For
TRUST_PROXY=1

# الكوكيز: عند الإنتاج (HTTPS) يُفعَّل Secure تلقائياً ويُسبَق اسم الكوكي بـ __Host-
# لتثبيت اسم مخصص (نادراً) عدّل التالي؛ وإلا يُستخدم الافتراضي.
COOKIE_SECURE=1
SESSION_COOKIE_NAME=rafidain_session
CSRF_COOKIE_NAME=rafidain_csrf

# بث الإشعارات الحي (SSE): حدود الاتصالات المتزامنة
SSE_MAX_CLIENTS=2000
SSE_MAX_PER_USER=5

# حد الطلبات (العدّاد مشترك عبر قاعدة البيانات وآمن للعنقود)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# قفل الحساب عند فشل الدخول
LOCKOUT_MAX_FAILURES=5
LOCKOUT_WINDOW_MIN=15
LOCKOUT_DURATION_MIN=15

# الرفع
UPLOAD_MAX_MB=10

# ===== إضافي/اختياري (لها افتراضيات آمنة إن حُذفت) =====

# الحد الأقصى لعدد عمال العنقود (فقط عند CLUSTER_WORKERS>0). الافتراضي 4.
CLUSTER_WORKERS_MAX=4

# يسمح ببذر قاعدة البيانات تلقائياً عند الإقلاع في الإنتاج (للتجربة فقط؛ افتراضياً معطّل).
SEED_ALLOW=0

# مدة صلاحية رمز JWT (مثل 1d, 12h, 3600). الافتراضي 1d.
JWT_EXPIRES_IN=1d

# اسم التطبيق المعروض. الافتراضي "سوق الرافدين".
APP_NAME=سوق الرافدين

# رابط الواجهة الأم لتوليد روابط الإحالة (الولاء). الافتراضي http://localhost:5173.
APP_URL=http://localhost:5173

# عدد قرّاء قاعدة البيانات (1..2). الافتراضي 2 (يُقلَّص إلى 1 تلقائياً عند نواة واحدة).
DB_READ_WORKERS=2

# حد الطلبات الكتابية العامة (نقاط غير محمية مثل الدخول/التسجيل). الافتراضي 300/دقيقة.
WRITE_RATE_LIMIT_MAX=300

# تدوير سجلات الصيانة عند بلوغ الحجم (بايت). الافتراضي 10MB.
LOG_ROTATE_BYTES=10485760

# الحد الأقصى لحزمة النسخ الاحتياطي (بايت). الافتراضي 1GB.
BACKUP_BUNDLE_MAX_BYTES=1073741824

# أمر رفع النسخة الاحتياطية إلى موقع خارجي (مثل gsutil/rclone). يُترك فارغاً للتعطيل.
OFFSITE_BACKUP_CMD=

# مفاتيح Web Push (VAPID). تُولَّد تلقائياً إن لم تُعطَ.
VAPID_KEYS_PATH=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rafidain.iq

# النسخ الاحتياطي إلى Google Cloud Storage (يُترك فارغاً للتعطيل).
GCS_BUCKET=
GCS_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_JSON=

# نسخ احتياطي سحابي متوافق مع S3 (Cloudflare R2 / Backblaze B2 / AWS S3) —
# يُستخدم بدلاً من GCS إن ضُبط كاملاً. لا يتطلب مكتبات إضافية (تنفيذ بـ fetch + توقيع AWS SigV4).
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=rafidain
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PREFIX=rafidain-backups

# جدولة رفع النسخ السحابي: كل كم ساعة (الافتراضي 24). لتعطيل الرصد آلياً ضع 1.
BACKUP_SCHEDULE_HOURS=24
BACKUP_SCHEDULE_DISABLED=0

# عدد النسخ المحلية للاحتفاظ بعد كل رفع سحابي (0 = عدم الحذف). الافتراضي 0.
CLOUD_BACKUP_KEEP=0

# تنبيهات نجاح/فشل النسخ عبر webhook (Slack/Telegram/...). يُترك فارغاً للتعطيل.
BACKUP_ALERT_WEBHOOK=
# ضبط 1 لإرسال تحذير webhook عندما لا يكون أي مزوّد سحابي مضبوطاً.
BACKUP_ALERT_WHEN_UNCONFIGURED=0

# ===== أساس بوابات الدفع (بنية معطّلة — لا يتم تشغيل أي بوابة حتى اعتماد رسمي) =====
# هذه البنية تُجهّز فقط أُسُس الاستقبال (جداول/خدمات/مسارات) ولا تُفعِّل أي بوابة.
# جميع البوابات مسجّلة معطّلة (is_active=0) في وضع تجريبي؛ أي طلب دفع يعيد 501.
# عند اكتمال أوراق التأسيس يُفعَّل التالي ثم تُضاف بوابة فعلية لاحقاً:
# PAYMENT_GATEWAY_ACTIVE=test   # 'test' يسمح بفحص النطاق دون تشغيل مالي فعلي

